{
  "manifest_version": 3,
  "name": "X 单向关注筛选器",
  "version": "0.1.0",
  "description": "一键找出你关注但没有关注你的 X 账号。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_title": "X 单向关注筛选器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
